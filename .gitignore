# Whitelist: ignore everything, reopen directories, then allow project files explicitly.
*
!*/

!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/NOTICE
!/pyproject.toml
!/uv.lock
!/uv.toml
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/biome.json
!/run.sh
!/run_tests.sh
!/Dockerfile
!/compose.yaml
!/.dockerignore
!/.env.example
!/.github/workflows/*.yml
!/scripts/**/*.sh
!/scripts/**/*.py
!/scripts/**/*.service
!/extras/**/*.py
!/extras/**/*.sh
!/extras/**/*.md
!/extras/**/*.service

!/server/**/*.py
!/server/templates/**/*.html
!/packs/**/*.toml
!/packs/**/*.tsv
!/packs/**/*.txt
!/packs/**/*.md
!/web/**/*.ts
!/web/**/*.css
!/tests/**/*.py
!/tests/**/*.json
!/examples/**/*.json
!/examples/**/*.py
!/examples/**/*.toml
!/examples/**/*.tsv
!/examples/**/*.md
!/lang-reader.example.toml

# Runtime and tool state stay private even though directories are reopened above.
# Your provider file and API keys never belong in the repository.
/lang-reader.toml
/config/
*.key
.env
/.lang/
/.mypy_cache/
/.pytest_cache/
/.ruff_cache/
/.venv/
/data/
/node_modules/
/server/static/
