{
  "name": "lang-reader-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./run.sh",
    "build": "tsc && cat web/styles/*.css > server/static/styles.css",
